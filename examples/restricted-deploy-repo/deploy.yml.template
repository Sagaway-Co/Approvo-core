# 放到【受限发版仓】的 .github/workflows/deploy.yml.
# 该仓只有少数运维/负责人可写;所有真实部署凭证 (kubeconfig / cloud AK/SK) 以 GitHub Secrets 形式
# 只存在此仓,业务仓开发无写权限 → 无法绕过审批直接发版.
#
# approvo 审批通过后 workflow_dispatch 触发本 workflow,带 inputs: app, tag, env.
name: deploy

on:
  workflow_dispatch:
    inputs:
      app:
        description: 目标应用名 (对应 approvo config.releases 里的 key)
        required: true
      tag:
        description: 镜像 tag / 版本号
        required: true
      env:
        description: 目标环境
        required: true
        default: prod

# run-name 决定 approvo 能不能定位到本次 run (dispatch_and_wait 按 display_title 匹配)
run-name: deploy ${{ inputs.app }} ${{ inputs.tag }} (${{ inputs.env }})

jobs:
  deploy:
    runs-on: ubuntu-latest         # 需能连集群;内网集群用 self-hosted runner 或 VPN
    steps:
      - name: Load kubeconfig
        env:
          KUBECONFIG_DATA: ${{ secrets.KUBECONFIG }}   # base64 编码的 kubeconfig,只此仓有
        run: |
          mkdir -p ~/.kube
          echo "$KUBECONFIG_DATA" | base64 -d > ~/.kube/config
          chmod 600 ~/.kube/config

      - name: Resolve deploy target by app
        id: t
        run: |
          set -euo pipefail
          # 各 app 的部署目标在这里维护 (开发碰不到).
          # 也可以改成读仓库里的 deploy-matrix.yaml,或 helm chart 化.
          case "${{ inputs.app }}" in
            api)
              echo "ns=default"            >> "$GITHUB_OUTPUT"
              echo "deployment=api"        >> "$GITHUB_OUTPUT"
              echo "container=api"         >> "$GITHUB_OUTPUT"
              echo "repo=registry.example.com/your-org/api" >> "$GITHUB_OUTPUT"
              ;;
            web)
              echo "ns=default"            >> "$GITHUB_OUTPUT"
              echo "deployment=web"        >> "$GITHUB_OUTPUT"
              echo "container=web"         >> "$GITHUB_OUTPUT"
              echo "repo=registry.example.com/your-org/web" >> "$GITHUB_OUTPUT"
              ;;
            *)
              echo "未知 app: ${{ inputs.app }}"; exit 1 ;;
          esac

      - name: Set image + wait rollout
        run: |
          set -euo pipefail
          IMAGE="${{ steps.t.outputs.repo }}:${{ inputs.tag }}"
          echo "▶ 部署 ${{ inputs.app }} → $IMAGE (ns=${{ steps.t.outputs.ns }})"
          kubectl -n "${{ steps.t.outputs.ns }}" set image \
            "deployment/${{ steps.t.outputs.deployment }}" \
            "${{ steps.t.outputs.container }}=$IMAGE"
          kubectl -n "${{ steps.t.outputs.ns }}" rollout status \
            "deployment/${{ steps.t.outputs.deployment }}" --timeout=300s
